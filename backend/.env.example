# App & Brand Configuration
APP_NAME="WhatsApp CRM — JWL"
BRAND_NAME="JWL"
DEFAULT_LOCALE=en
ENVIRONMENT=production
ALLOWED_ORIGINS=https://your-frontend-domain.vercel.app

# Security & Secrets (MUST be random 32+ character strings in production)
SECRET_KEY=your_secure_secret_key_here_min_32_chars
APP_ENCRYPTION_KEY=your_aes256_encryption_key_min_32_chars
WEBHOOK_SECRET=your_webhook_hmac_secret_here_min_16_chars
META_APP_SECRET=your_meta_app_secret_here_min_16_chars
AUDIT_HASH_SALT=your_secure_salt_for_recipient_hashes

# Redis (Distributed Rate Limiting)
REDIS_URL=redis://127.0.0.1:6379/0
TRUSTED_PROXIES=127.0.0.1,::1

# Integration Gateway Allowed Hosts
INTEGRATION_ALLOWED_HOSTS=store.example.com,api.jwl-billion.com

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@prod-db.example.com:5432/whatsapp_crm
DB_PASSWORD=your_postgres_password_here

# Meta WhatsApp Cloud API Configuration
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_business_id_here
WHATSAPP_API_TOKEN=your_permanent_access_token_here
WHATSAPP_VERIFY_TOKEN=your_custom_verify_token_here
WHATSAPP_WEBHOOK_URL=https://your-backend-domain.com/api/webhooks/whatsapp
META_GRAPH_BASE_URL=https://graph.facebook.com
META_GRAPH_VERSION=v19.0

# Admin Initial Credentials (used for initial seed on first boot)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=SetAStrongPasswordHere!123
INITIAL_ADMIN_EMAIL=admin@jwl-billion.com

# E-Commerce Integration Service Account (used by Shopify store webhooks)
ECOM_SERVICE_USERNAME=ecom_service
ECOM_SERVICE_PASSWORD=SetAStrongServicePasswordHere!123
ECOM_SERVICE_EMAIL=ecommerce@jwl-billion.com

# Business Logic & Rate Guardrails
MAX_USERS_LIMIT=5
DAILY_MESSAGE_SEND_LIMIT=200
DEFAULT_COUPON_CODE=WELCOME
DEFAULT_DISCOUNT_PERCENT=10
DEFAULT_EXPIRY_DAYS=30
HTTP_TIMEOUT_SECONDS=15.0
SCHEDULER_ENABLED=false

# Store Details & External Feeds
STORE_SUPPORT_PHONE=+919876543210
STORE_LOCATION=Ahmedabad
STORE_INACTIVE_FEED_URL=https://store.example.com/api/inactive-customers
